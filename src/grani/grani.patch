+// Carciofo: lets the firmware thin out the grains under heavy load.
+void Processor::ShedGrains(int count) {
+  switch (media_) {
+    case MEDIA_DIGITAL:
+      processor_digital_.ShedGrains(count);
+      break;
+    case MEDIA_VINTAGE_DIGITAL:
+      processor_vintage_digital_.ShedGrains(count);
+      break;
+    case MEDIA_CLEAN_TAPE:
+      processor_clean_tape_.ShedGrains(count);
+      break;
+    case MEDIA_DIRTY_TAPE:
+      processor_dirty_tape_.ShedGrains(count);
+      break;
+  }
+}
+
 void Processor::Configure(Media media, bool mono) {
   media_ = media;
   mono_ = mono;
