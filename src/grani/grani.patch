Grani's changes to Beads and stmlib, applied to a copy of lib/eurorack in
build/upstream by the Makefile. The codec runs at 48 kHz in dirty tape too,
the firmware can fade out grains when the processor runs out of time, and
the sine and pitch tables are filled at power up (tables.cpp) to save flash.

--- a/beads/dsp/granular_player.h
+++ b/beads/dsp/granular_player.h
@@ -126,6 +126,24 @@
     *pan = BoundedRandomFloat(pan_spread);
   }
   
+  // Carciofo: fades out the grains closest to their end, used when the
+  // processor runs out of time.
+  inline void Shed(int count) {
+    for (int n = 0; n < count; ++n) {
+      T* victim = NULL;
+      for (int i = 0; i < num_grains; ++i) {
+        T* g = &grain_[i];
+        if (!g->done() && g->remaining_samples() > instant_crossfade_time_ &&
+            (!victim ||
+             g->remaining_samples() < victim->remaining_samples())) {
+          victim = g;
+        }
+      }
+      if (!victim) return;
+      victim->FadeOut(instant_crossfade_time_);
+    }
+  }
+
   inline T* new_grain() { return grain_priority_list_[0]; }
   
   inline void Tick() {
